# Default locale when the URL has no language prefix (e.g. /about → en)
DEFAULT_LANG=en

# Live CMS preview — when true, data-cms content is fetched client-side directly
# from PatStore (VITE_PATSTORE_CLIENT_KEY, GraphQL) on every route change and
# polled every few seconds, bypassing the build-time cms-content/ snapshot so
# CMS edits show up without a rebuild. Off by default; requires VITE_PATSTORE_*
# below to be set. See src/provider/content/live-content.ts.
# PREVIEW_ENABLED=true

# PatStore / Parse Server (SASHIDO) — client (bundled)
VITE_PATSTORE_API_URL=https://your-instance.sashidocloud.com/1
VITE_PATSTORE_GRAPHQL_API_URL=https://your-instance.sashidocloud.com/1/graphql
VITE_PATSTORE_APP_ID=your-app-id
VITE_PATSTORE_REST_KEY=your-rest-api-key
VITE_PATSTORE_CLIENT_KEY=your-client-key
VITE_PATSTORE_FILE_URL=https://your-instance.sashidocloud.com/1/files
VITE_PATSTORE_PROJECT_ID=your-project-object-id

# SSG / build-time fetch (server-only — never commit real values to git)
PATSTORE_MASTER_KEY=your-master-key

# SSG enabled by default on dev/build; set false to skip build-time CMS fetch
# VITE_PATSTORE_SSG=true

# Prefer static JSON from data/ when available; set false to force runtime fetch
# VITE_PATSTORE_USE_STATIC=true

# Download CMS file fields into asset/ during SSG (served at /asset/*)
# VITE_PATSTORE_DOWNLOAD_ASSETS=true

# CLIENT_KEY  — browser-safe key for runtime fallback fetching
# PATSTORE_MASTER_KEY — used by vite-plugin-patstore during dev/build (not exposed to client)

# CMS page content sync (plugins/cms-content) — scans src/pages/**/*.tsrx for
# data-cms-section / data-cms markers and syncs default values into PatStore's
# Webpage class (uses the VITE_PATSTORE_* vars above; PATSTORE_MASTER_KEY or
# VITE_PATSTORE_REST_KEY required).

# Disable scanning/syncing entirely; site falls back to scanned JSX defaults
# VITE_CMS_CONTENT_SYNC=true

# PatStore class that stores page content (project + path + page_data + page_content)
# VITE_CMS_CONTENT_CLASS=Webpage

# Array-type field on that class holding [{ path, value }, ...] entries — the
# edited values, merged over scanned defaults and read back by the site
# VITE_CMS_CONTENT_FIELD=page_data

# Field on that class holding the nested field schema (type/label/default per
# data-cms key) that PatStore's editor renders from — fully overwritten from
# the current scan on every dev/build so the editor stays in sync with code
# VITE_CMS_CONTENT_SCHEMA_FIELD=page_content

# className the Webpage "project" pointer field targets — set empty/"" if
# "project" is a plain string field on Webpage instead of a Pointer
# VITE_PATSTORE_PROJECT_CLASS=Project
